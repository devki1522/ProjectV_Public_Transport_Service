# Copy to backend/.env without overwriting an existing file.
# Credentials must match the root .env.
# For a backend running outside Docker, replace database with localhost.
PORT=8080
DATABASE_URL=postgres://projectv:local_dev_password@database:5432/public_transport?sslmode=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h

# Environment and authentication trust boundary
# Allowed APP_ENV: development, staging, production (defaults to production when unset)
# Allowed AUTH_PROVIDER: mock (development only), registration (default outside development)
APP_ENV=development
AUTH_PROVIDER=mock
AUTH_REQUIRED_ROLE=TransitAdministrator

# Session cookie and CSRF protection
AUTH_SESSION_COOKIE=transit_session
AUTH_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_TRUSTED_PROXY=false

# Development mock provider (forbidden outside APP_ENV=development)
# Generate at least 32 bytes for MOCK_JWT_SECRET and set local passwords before starting.
MOCK_JWT_ISSUER=transit-dev
MOCK_JWT_AUDIENCE=transit-api
MOCK_JWT_SECRET=
MOCK_ADMIN_PASSWORD=
MOCK_USER_PASSWORD=

# External Registration Service provider (used when AUTH_PROVIDER=registration)
# HTTPS is required outside explicit local development.
# REGISTRATION_SERVICE_URL=https://registration.example.com
# REGISTRATION_JWT_ISSUER=CmRegistrationService
# REGISTRATION_JWT_AUDIENCE=CmRegistrationClients
# REGISTRATION_JWT_SECRET=
