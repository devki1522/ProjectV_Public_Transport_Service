# Optional overrides. Local development needs no backend/.env at all:
# with APP_ENV=development the backend defaults everything below, and compose.yaml
# sets APP_ENV and DATABASE_URL. Copy to backend/.env only to change something.
# Never put real secrets in a committed file.

# --- Required only when running the backend outside Docker ---
# APP_ENV=development
# DATABASE_URL=postgres://projectv:local_dev_password@localhost:5432/public_transport?sslmode=disable

# --- Server and database pool (defaults shown) ---
# PORT=8080
# API_VERSION=v1
# DB_MAX_IDLE_CONNS=5
# DB_MAX_OPEN_CONNS=20
# DB_CONN_MAX_LIFETIME=1h

# --- Authentication ---
# APP_ENV: development, staging, production (defaults to production when unset).
# AUTH_PROVIDER defaults to mock in development and registration everywhere else.
# AUTH_PROVIDER=mock
# AUTH_REQUIRED_ROLE=TransitAdministrator
# AUTH_SESSION_COOKIE=transit_session
# AUTH_COOKIE_SECURE=false            # forced true outside development
# AUTH_TRUSTED_ORIGINS=http://localhost:3000
# AUTH_TRUSTED_PROXY=false

# Development mock login (rejected outside APP_ENV=development).
# Sign in as transit.admin / Test!123. The signing key is generated at startup.
# MOCK_ADMIN_PASSWORD=Test!123
# MOCK_JWT_SECRET=                    # optional, >= 32 bytes; random per boot when unset

# External Registration Service (AUTH_PROVIDER=registration). HTTPS is required.
# REGISTRATION_SERVICE_URL=https://registration.example.com
# REGISTRATION_JWT_ISSUER=CmRegistrationService
# REGISTRATION_JWT_AUDIENCE=CmRegistrationClients
# AUTH_ADMIN_WHITELIST=your.registration.username
# Login trusts the direct HTTPS response; session signing keys are generated locally.

# --- Live bus simulator (defaults to on in development, off elsewhere) ---
# SIMULATE_VEHICLES=true
# SIMULATE_VEHICLES_COUNT=24
# SIMULATE_TICK_INTERVAL=3s

# --- Staff / HR integration (URL defaults to the CMES service in development) ---
# STAFF_HR_SERVICE_URL=https://cmes-staffhr-api-gtofz7g3n2z56.azurewebsites.net
# STAFF_HR_DEPARTMENT_CODE=PTR

# --- Budget & Finance integration (URL defaults to the Group 5 Finance API in development) ---
# BUDGET_SERVICE_URL=https://financeapi20261125000202-g9ctbdc4axdscbet.westus-01.azurewebsites.net
# BUDGET_DEPARTMENT_CODE=TRANSIT
