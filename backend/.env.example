# Copy to backend/.env. Credentials must match the root .env.
# For a backend running outside Docker, replace database with localhost.
PORT=8080
DATABASE_URL=postgres://transport:local_dev_password@database:5432/public_transport?sslmode=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h
